# VoterSaathi+ Environment Configuration
# Copy this to .env and fill in your values

# Server
PORT=8080
NODE_ENV=production

# Google Cloud Project
GCP_PROJECT_ID=votersaathi-edge-cloud
GCP_REGION=asia-south1

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# Google Cloud Translation API
GOOGLE_TRANSLATE_API_KEY=your_translate_api_key_here

# Google Cloud Speech-to-Text / Text-to-Speech
GOOGLE_SPEECH_API_KEY=your_speech_api_key_here

# Google Document AI
GOOGLE_DOCAI_PROCESSOR_ID=your_processor_id_here

# Firebase / Firestore
FIREBASE_PROJECT_ID=votersaathi-edge-cloud
FIREBASE_API_KEY=your_firebase_api_key_here

# Google OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
